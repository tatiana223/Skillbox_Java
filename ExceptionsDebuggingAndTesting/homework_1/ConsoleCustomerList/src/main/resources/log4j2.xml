<?xml version="1.0" encoding="UTF-8" ?>
<Configuration status = "WARN">
    <Appenders>
        <File name="QueriesFile" fileName="logs/queries.log">
            <PatternLayout>
                <Pattern>
                    %d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n
                </Pattern>
            </PatternLayout>
        </File>

        <File name="ErrorsFile" fileName="logs/errors.log">
            <PatternLayout>
                <Pattern>%d{yyy-MM-dd HH-mm-ss} [%t] %-5level %logger{36} - %msg%n</Pattern>
            </PatternLayout>
        </File>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:MM:SS} %-5level - %msg%n" />
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="queries" level="info" additivity="false">
            <AppenderRef ref="QueriesFile" />
        </Logger>

        <Logger name="errors" level="error" additivity="false">
            <AppenderRef ref="ErrorsFile" />
        </Logger>

        <Root level="warn">
            <AppenderRef ref="Console" />
        </Root>
    </Loggers>
</Configuration>